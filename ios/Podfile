def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(\n      '#{script}',\n      {paths: [process.argv[1]]},\n    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!
project 'Swipelane.xcodeproj'

# Ensure codegen runs for New Architecture modules (e.g., RNShareSpec).
ENV['RCT_SKIP_CODEGEN'] = '0'

# iOS permission handlers required by react-native-permissions
setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'SpeechRecognition',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Swipelane' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Allow non-modular includes when building pods as frameworks.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

        if target.name == 'RNShare'
          # RNShare uses <RNShareSpec/...> includes; ensure ReactCodegen headers are visible.
          react_codegen_path = '$(PODS_ROOT)/Headers/Public/ReactCodegen'
          header_search_paths = build_config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'

          if header_search_paths.is_a?(Array)
            header_search_paths << react_codegen_path unless header_search_paths.include?(react_codegen_path)
            build_config.build_settings['HEADER_SEARCH_PATHS'] = header_search_paths
          else
            unless header_search_paths.include?(react_codegen_path)
              build_config.build_settings['HEADER_SEARCH_PATHS'] = "#{header_search_paths} \"#{react_codegen_path}\""
            end
          end
        end
      end
    end
  end
end
